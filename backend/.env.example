# FastAPI application name. You can keep the default.
APP_NAME=AI QA Assistant
APP_ENV=local
LOG_LEVEL=INFO
STRICT_CONFIG_VALIDATION=false

# Your large model API key. Do not commit your real key.
LLM_API_KEY=replace-with-your-api-key

# OpenAI-compatible base URL, without /chat/completions at the end.
# Examples:
# OpenAI: https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# SiliconFlow: https://api.siliconflow.cn/v1
LLM_BASE_URL=https://api.openai.com/v1

# Model name from your provider.
# Examples:
# OpenAI: gpt-4o-mini
# DeepSeek: deepseek-chat
# SiliconFlow: Qwen/Qwen2.5-7B-Instruct
LLM_MODEL=gpt-4o-mini

# Request timeout in seconds.
LLM_TIMEOUT=30

# Embedding API configuration. If EMBEDDING_API_KEY or EMBEDDING_BASE_URL is
# empty, the backend will fall back to LLM_API_KEY / LLM_BASE_URL.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# Chroma local vector database.
DATABASE_PATH=app.db
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=ai_qa_documents

# RAG rerank. Configure RERANK_MODEL to use a professional rerank API.
# If the professional rerank API fails or is not configured, the backend
# falls back to LLM rerank or rule-based rerank.
RERANK_ENABLED=true
RERANK_CANDIDATE_TOP_K=20
RERANK_FINAL_TOP_K=5
RERANK_API_KEY=
RERANK_BASE_URL=
RERANK_MODEL=
RERANK_API_FORMAT=auto
RERANK_TIMEOUT=30
RERANK_USE_LLM=false
